BOT_TOKEN=123456:replace_me
DATABASE_URL=sqlite+aiosqlite:///sleep_tracker.db
# Для постоянного SQLite можно указать абсолютный путь, например /var/data/sleep_tracker.db.
DB_PATH=
# На Render замените на Internal Database URL из PostgreSQL.
BOT_TIMEZONE=Europe/Chisinau
LOG_LEVEL=INFO
# Пусто = доступ всем; иначе положительные Telegram ID через запятую.
ALLOWED_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
