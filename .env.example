BOT_TOKEN=123456:replace_me
# По умолчанию используется data/baby_tracker.db.
DB_DIR=data
DB_PATH=
# На Render с постоянным диском задайте DB_PATH=/var/data/baby_tracker.db.
# DATABASE_URL имеет приоритет и нужен только для PostgreSQL или явного SQLite URL.
DATABASE_URL=
BOT_TIMEZONE=Europe/Chisinau
LOG_LEVEL=INFO
# Пусто = доступ всем; иначе положительные Telegram ID через запятую.
ALLOWED_IDS=
# Дополнительные администраторы через запятую. ID создателей уже встроены в config.py.
ADMIN_IDS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
